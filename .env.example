# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# docker-compose.yml reads .env automatically for the ${VAR} substitutions inside it.

# Used directly by docker-compose.yml to configure the postgres service.
# Also what the app connects with (via DATABASE_URL below) once both containers are up.
POSTGRES_DB=workly
POSTGRES_USER=workly
POSTGRES_PASSWORD=change-me

# Only needed if running the app OUTSIDE docker-compose (e.g. `./mvnw spring-boot:run` against
# a docker-compose'd Postgres exposed on localhost:5432). Inside docker-compose, DATABASE_URL is
# already set for you in docker-compose.yml using the "postgres" service hostname instead.
DATABASE_URL=jdbc:postgresql://localhost:5432/workly
DATABASE_USERNAME=workly
DATABASE_PASSWORD=change-me

# JWT signing secret — generate a real one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-real-random-256-bit-secret
