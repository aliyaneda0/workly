# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# docker-compose.yml reads .env automatically for the ${VAR} substitutions inside it.

# Used directly by docker-compose.yml to configure the postgres service.
# Also what the app connects with (via DATABASE_URL below) once both containers are up.
POSTGRES_DB=workly
POSTGRES_USER=workly
POSTGRES_PASSWORD=change-me

# Only needed if running the app OUTSIDE docker-compose (e.g. `./mvnw spring-boot:run` against
# a docker-compose'd Postgres exposed on localhost:5433 — see docker-compose.yml's ports comment
# for why it's 5433, not the default 5432). Inside docker-compose, DATABASE_URL is already set for
# you in docker-compose.yml using the "postgres" service hostname instead.
DATABASE_URL=jdbc:postgresql://localhost:5433/workly
DATABASE_USERNAME=workly
DATABASE_PASSWORD=change-me

# JWT signing secret — generate a real one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-real-random-256-bit-secret

# First ADMIN account, created on startup if no account with this email exists yet. Leave both
# blank to skip. Password must be at least 8 characters. Registration can't create admins, so
# this is the only way to get one.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# company-service's own Postgres — separate container, separate database, separate vars from
# the monolith's POSTGRES_* above (different names so one .env can hold both).
COMPANY_POSTGRES_DB=company
COMPANY_POSTGRES_USER=company
COMPANY_POSTGRES_PASSWORD=change-me

# Only needed if running company-service OUTSIDE docker-compose directly. Host port 5434 —
# 5432 is the native Postgres service, 5433 is the monolith's own Postgres (see above).
COMPANY_DATABASE_URL=jdbc:postgresql://localhost:5434/company
COMPANY_DATABASE_USERNAME=company
COMPANY_DATABASE_PASSWORD=change-me

# job-service's own Postgres — same pattern as company-service's, separate names again.
JOB_POSTGRES_DB=job
JOB_POSTGRES_USER=job
JOB_POSTGRES_PASSWORD=change-me

# Only needed if running job-service OUTSIDE docker-compose directly. Host port 5435 —
# 5432/5433/5434 are already taken (native Postgres, the monolith, company-service).
JOB_DATABASE_URL=jdbc:postgresql://localhost:5435/job
JOB_DATABASE_USERNAME=job
JOB_DATABASE_PASSWORD=change-me

# review-service's own Postgres — same pattern as company-service's/job-service's, separate
# names again.
REVIEW_POSTGRES_DB=review
REVIEW_POSTGRES_USER=review
REVIEW_POSTGRES_PASSWORD=change-me

# Only needed if running review-service OUTSIDE docker-compose directly. Host port 5436 —
# 5432/5433/5434/5435 are already taken (native Postgres, the monolith, company-service,
# job-service).
REVIEW_DATABASE_URL=jdbc:postgresql://localhost:5436/review
REVIEW_DATABASE_USERNAME=review
REVIEW_DATABASE_PASSWORD=change-me
